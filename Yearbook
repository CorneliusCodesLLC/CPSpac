<style>
    /* CSS RESET & VARIABLES - Scoped */
    .yearbook-wrapper {
        --bg-color: #fdfcf9;
        --text-color: #111111;
        --text-muted: #555555;
        --border-color: #111111;
        --accent-bg: #ffffff;
        --chi-blue: #41B6E6;
        --chi-red: #CE1126;
        font-family: 'Roboto', sans-serif;
        color: var(--text-color);
        background-color: var(--bg-color);
        line-height: 1.6;
    }

    .yearbook-wrapper * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* TYPOGRAPHY */
    .yearbook-wrapper h1, 
    .yearbook-wrapper h2, 
    .yearbook-wrapper h3, 
    .yearbook-wrapper .headline-serif {
        font-family: 'Lora', serif;
        color: var(--text-color);
        font-weight: 700;
    }

    /* HERO SECTION */
    .yearbook-wrapper .hero {
        padding: 4rem 5% 3rem 5%;
        text-align: center;
        max-width: 850px;
        margin: 0 auto;
    }

    .yearbook-wrapper .hero h1 {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: -1px;
        margin-bottom: 1.25rem;
        text-transform: uppercase;
        position: relative;
        display: inline-block;
    }
    
    .yearbook-wrapper .hero h1::after {
        content: '';
        display: block;
        width: 60%;
        height: 4px;
        background-color: var(--chi-red);
        margin: 0.5rem auto 0;
    }

    .yearbook-wrapper .hero p {
        font-size: 1.15rem;
        color: var(--text-muted);
    }

    /* YEARBOOK GRID LAYOUT */
    .yearbook-wrapper .yearbook-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 5% 4rem;
    }

    .yearbook-wrapper .race-section {
        margin-bottom: 5rem;
        border-top: 6px double var(--border-color);
        padding-top: 2.5rem;
    }

    .yearbook-wrapper .race-header {
        font-size: 1.85rem;
        font-weight: 800;
        margin-bottom: 0.2rem;
        text-transform: uppercase;
        color: var(--chi-red);
    }

    .yearbook-wrapper .race-sub {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--chi-blue);
        margin-bottom: 2.5rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .yearbook-wrapper .candidates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
        gap: 3rem;
    }

    /* YEARBOOK CARD STYLING */
    .yearbook-wrapper .candidate-card {
        display: flex;
        background: var(--accent-bg);
        border: 2px solid var(--border-color);
        padding: 1.75rem;
        gap: 1.75rem;
        align-items: flex-start;
        box-shadow: 5px 5px 0px var(--chi-blue);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .yearbook-wrapper .candidate-card:hover {
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0px var(--chi-blue);
    }

    /* Alternate box shadow color for Incumbents to stand out */
    .yearbook-wrapper .candidate-card.incumbent-card {
        box-shadow: 5px 5px 0px var(--chi-red);
    }
    
    .yearbook-wrapper .candidate-card.incumbent-card:hover {
        box-shadow: 8px 8px 0px var(--chi-red);
    }

    .yearbook-wrapper .photo-wrapper {
        flex: 0 0 150px;
        text-align: center;
        position: relative;
        padding-bottom: 3.5rem; /* Creates breathing room for the absolute label below */
    }

    /* Image Link Button Styling */
    .yearbook-wrapper .photo-wrapper a.img-link {
        display: block;
        border: 2px solid var(--border-color);
        background-color: #e0e0e0;
        transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }

    .yearbook-wrapper .photo-wrapper a.img-link:hover {
        transform: translateY(-4px);
        box-shadow: 4px 4px 0px var(--border-color);
    }

    .yearbook-wrapper .photo-wrapper a.img-link:hover img {
        filter: grayscale(0%) contrast(100%);
    }

    .yearbook-wrapper .photo-wrapper a.img-link img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        display: block;
        margin: 0;
        filter: grayscale(10%) contrast(110%);
    }

    /* Typewriter Label Aesthetic */
    .yearbook-wrapper .superlative {
        font-family: 'Courier Prime', Courier, monospace;
        font-size: 0.85rem;
        line-height: 1.35;
        color: var(--text-color);
        background: #fff9e6; 
        padding: 8px 10px;
        border: 1px dashed var(--text-muted);
        transform: rotate(-1.5deg);
        position: absolute;
        /* Image is 180px tall. 165px pins the top of the label exactly 15px above the bottom of the image. It expands downward if text wraps. */
        top: 165px; 
        left: -10px;
        right: -10px;
        z-index: 2;
        box-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        pointer-events: none; /* Prevents the label from interfering with the clickable image behind it */
    }

    .yearbook-wrapper .candidate-card:nth-child(even) .superlative {
        transform: rotate(1.5deg);
    }

    .yearbook-wrapper .bio-wrapper {
        flex: 1;
    }

    .yearbook-wrapper .bio-wrapper h3 {
        font-size: 1.4rem;
        font-weight: 800;
        margin-bottom: 0.35rem;
    }

    .yearbook-wrapper .role-tag {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        background: var(--text-color);
        color: var(--accent-bg);
        padding: 4px 8px;
        margin-bottom: 1rem;
        letter-spacing: 0.5px;
    }
    
    .yearbook-wrapper .role-tag.incumbent {
        background: var(--chi-red);
    }

    .yearbook-wrapper .role-tag.write-in {
        background: var(--chi-blue);
    }

    .yearbook-wrapper .bio-wrapper p {
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.5;
    }

    /* THIRD CANDIDATE NOTE CARD */
    .yearbook-wrapper .third-candidate-card {
        display: flex;
        align-items: center;
        background-color: var(--accent-bg);
        border: 2px solid var(--border-color);
        padding: 1.25rem;
        margin-top: 2.5rem;
        max-width: 650px;
        box-shadow: 4px 4px 0px var(--text-muted);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .yearbook-wrapper .third-candidate-card:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0px var(--text-muted);
    }

    .yearbook-wrapper .third-candidate-card a.img-link {
        display: block;
        margin-right: 1.25rem;
        transition: transform 0.2s ease;
    }
    
    .yearbook-wrapper .third-candidate-card a.img-link:hover {
        transform: scale(1.05);
    }

    .yearbook-wrapper .third-candidate-card a.img-link img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid var(--border-color);
        background-color: #eeeeee;
        display: block;
    }

    .yearbook-wrapper .third-candidate-card h4 {
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 0.25rem;
        color: var(--text-color);
    }

    .yearbook-wrapper .third-candidate-card p {
        font-size: 0.9rem;
        margin: 0;
        color: var(--text-muted);
        line-height: 1.4;
    }

    /* EXPLANATION SECTION */
    .yearbook-wrapper .district-explanation {
        background-color: #fff9e6; 
        border: 2px solid var(--border-color);
        padding: 3rem;
        margin: 2rem 5% 4rem;
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
        box-shadow: 8px 8px 0px var(--chi-blue);
        position: relative;
    }
    
    .yearbook-wrapper .district-explanation::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        width: 8px;
        background: repeating-linear-gradient(
            -45deg,
            var(--chi-blue),
            var(--chi-blue) 10px,
            var(--chi-red) 10px,
            var(--chi-red) 20px
        );
    }

    .yearbook-wrapper .district-explanation h2 {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: 1.25rem;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }

    .yearbook-wrapper .district-explanation p {
        margin-bottom: 1.25rem;
        font-size: 1.05rem;
        color: var(--text-color);
    }

    @media (max-width: 650px) {
        .yearbook-wrapper .candidates-grid {
            grid-template-columns: 1fr;
        }
        .yearbook-wrapper .candidate-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 2rem 1.5rem;
        }
        .yearbook-wrapper .photo-wrapper {
            flex: auto;
            width: 150px;
            max-width: 150px;
            margin-bottom: 1rem;
        }
    }
</style>

